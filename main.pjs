$meta
  title = Календар і Щоденник
  description = Розумний календар, графік дня по годинах, щоденник домашніх завдань, ШІ-помічник та ранкова зарядка — усе в одному застосунку.
  tags = календар, щоденник, графік, розклад, планер, школа, зарядка, ші, planner, calendar, diary
  header
    mode = minimal

generateText = {import:ai-text-plugin}
kv = {import:kv-plugin}

// ---- Конфігурація застосунку ----

appName = KRI Планер

// Скільки тижнів уперед можна гортати в «Календарі»
weekLookahead = 3

// Скільки днів уперед показує «Графік дня»
dayLookahead = 3

// Скільки днів уперед показує сторінка «Завдання» у щоденнику
taskLookahead = 2

// Хвилини, за які подія підсвічується й починає «ворушитися»
soonMinutes = 5

// Час ранкової зарядки за замовчуванням
defaultExerciseTime = 09:00
